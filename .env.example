# Copy to .env.local. Never commit real values.

# Public site URL. Used for metadata, the sitemap, and the links in auth emails.
# Must match the Site URL configured in Supabase (Authentication > URL Configuration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API Keys).
# Use the PUBLISHABLE key only. It is safe for the browser because row level security protects the data.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable or in this app's code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
