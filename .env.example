# Medyra environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# Production and preview values live in Netlify (Site configuration > Environment variables),
# scoped per deploy context. See DEPLOYMENT.md.
#
# Rules:
#  - Variables starting with NEXT_PUBLIC_ are sent to every browser. Only put public identifiers
#    there, never a secret.
#  - Every service below is OPTIONAL except Supabase. If its variables are missing, the feature
#    quietly turns off and the rest of Medyra keeps working. Check /api/health to see which are on.

# =============================================================================
# 1. PUBLIC (browser-safe)
# =============================================================================

# Public site URL. Used for metadata, the sitemap and links in emails. Must match the Site URL in
# Supabase (Authentication > URL Configuration).
#   local:      http://localhost:3000
#   preview:    set per deploy context in Netlify (or leave to the Netlify URL)
#   production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment label: development | preview | production. Netlify sets this per deploy context in
# netlify.toml. Used for the Sentry environment and Redis key prefixes. Not a secret.
NEXT_PUBLIC_APP_ENV=development

# Supabase project (Project Settings > API Keys). REQUIRED.
# The PUBLISHABLE key is safe in the browser because row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry DSN (Sentry project > Settings > Client Keys). A DSN is a public identifier. Optional:
# without it, Sentry never starts.
NEXT_PUBLIC_SENTRY_DSN=

# ProductBridge organization id (ProductBridge > Settings > Connect > Widget & Embeds). A public
# identifier used to build the feedback / roadmap / changelog links. Optional.
NEXT_PUBLIC_PRODUCTBRIDGE_ORG_ID=

# =============================================================================
# 2. SERVER-ONLY SECRETS (never prefix with NEXT_PUBLIC_, never log, never commit)
# =============================================================================

# NEVER add the Supabase secret / service_role key to this app. Medyra only uses the publishable
# key; authorization is enforced by row level security.

# --- Resend (transactional email sent by the app) ---
# API key from resend.com > API Keys. Optional.
RESEND_API_KEY=
# Sender, on a domain you verified in Resend. Format: Medyra <hello@your-domain.example>
EMAIL_FROM=

# --- Upstash Redis (rate limiting and short-lived caches) --- Optional.
# Official variable names, from the Upstash console (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pinecone (future semantic search; disabled unless both are set) --- Optional.
PINECONE_API_KEY=
PINECONE_INDEX=
# Embedding model. The index dimension must match (multilingual-e5-large = 1024, cosine).
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# --- Sentry source maps (build time only) --- Optional.
# Auth token from Sentry > Settings > Auth Tokens. Set only in Netlify build env, never locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Sentry test endpoint --- Optional.
# Set to a long random string to enable GET /api/sentry-test (send it in the x-sentry-test-token
# header). Leave empty in production unless you are running the test in TESTING.md.
SENTRY_TEST_TOKEN=

# =============================================================================
# 3. SET BY THE PLATFORM (do not set yourself)
# =============================================================================
# CONTEXT (Netlify: production | deploy-preview | branch-deploy), NODE_ENV, CI, NETLIFY.

# =============================================================================
# 4. SUPABASE AUTH EMAIL (configured in the Supabase dashboard, not here)
# =============================================================================
# Sign-up confirmation and password-reset emails are sent by Supabase Auth through custom SMTP
# (Resend: smtp.resend.com, port 465, user "resend", password = a Resend API key). See
# EMAIL_SETUP.md.

# --- Development seed tool (scripts/seed, see TESTING.md). Dev project only. ---
# The only Supabase project ref the seed tool is allowed to write to.
SEED_ALLOWED_PROJECT_REF=
# Comma-separated emails that seed:wipe must keep (leave empty to be asked).
SEED_KEEP_EMAILS=
# Set to true on dev previews to show a DEMO DATA banner on every page.
NEXT_PUBLIC_DEMO_DATA_BANNER=
# Scoped Supabase access token limited to the dev project. Export it for the command only;
# never put it in a file you commit.
# SUPABASE_ACCESS_TOKEN=

# =============================================================================
# 7. ACCOUNT SECURITY AND PRIVACY (Phase 4A)
# =============================================================================
# Two-step sign-in. "required" (default when unset): every member needs an authenticator app and
# is sent to a setup page until they have one. "challenge": only members who enrolled are asked
# for a code (gradual rollout, and the emergency switch if TOTP is disabled in Supabase). "off":
# nothing enforced (local development only). Administrators always need a second factor.
MFA_ENFORCEMENT=
# Mailbox members contact about their personal information. Leave empty until it exists: the
# privacy pages then say no contact has been set up instead of inventing one.
PRIVACY_CONTACT_EMAIL=
